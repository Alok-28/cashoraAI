{
  "version": 2,
  "buildCommand": "cd server && npm install",
  "installCommand": "echo 'Install handled by buildCommand'",
  "env": {
    "NODE_ENV": "production"
  },
  "functions": {
    "server/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js",
      "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"]
    },
    {
      "src": "/auth/(.*)",
      "dest": "/server/index.js",
      "methods": ["GET", "POST", "OPTIONS"]
    },
    {
      "src": "/login/(.*)",
      "dest": "/login/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/index.html"
    },
    {
      "src": "/contact/(.*)",
      "dest": "/contact/index.html"
    },
    {
      "src": "/(.*)\\.html",
      "dest": "/$1.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "public": true,
  "framework": "nodejs"
}
